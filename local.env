# Point the server at the docker compose containers. `source ./local.env`
# before `go run ./cmd/server` or `go test ./...`.
export DATABASE_URL='postgres://pinpost:pinpost@localhost:5432/pinpost?sslmode=disable'
export S3_ENDPOINT_URL=http://localhost:9000    # RustFS
export AWS_REGION=us-east-1
export AWS_ACCESS_KEY_ID=pinpost
export AWS_SECRET_ACCESS_KEY=pinpost-secret
