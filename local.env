# Point the AWS SDK at the docker compose containers. `source ./local.env`
# before `go run ./cmd/server` or `go test ./...`.
export AWS_ENDPOINT_URL=http://localhost:8000   # DynamoDB Local
export S3_ENDPOINT_URL=http://localhost:9000    # MinIO
export AWS_REGION=us-east-1
export AWS_ACCESS_KEY_ID=pinpost
export AWS_SECRET_ACCESS_KEY=pinpost-secret
